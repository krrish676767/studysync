# Copy this file to .env.local and adjust if your setup differs.

# ---- MySQL -------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=studysync

# One MySQL account per application role (created by sql/04_roles.sql)
MYSQL_STUDENT_USER=ss_student
MYSQL_STUDENT_PASSWORD=StudySync@Student1
MYSQL_INSTRUCTOR_USER=ss_instructor
MYSQL_INSTRUCTOR_PASSWORD=StudySync@Instructor1
MYSQL_ADMIN_USER=ss_admin
MYSQL_ADMIN_PASSWORD=StudySync@Admin1
MYSQL_AUTH_USER=ss_auth
MYSQL_AUTH_PASSWORD=StudySync@Auth1

# ---- MongoDB -----------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=studysync

# ---- Auth --------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string-before-any-real-use
